NODE_ENV=development
PORT=5000
API_PREFIX=api/v1
APP_NAME=Cynova API
FRONTEND_ORIGINS=http://localhost:3000
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-64-character-secret
JWT_ISSUER=cynova-api
JWT_AUDIENCE=cynova-web
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=14d
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
SWAGGER_ENABLED=true
LOG_LEVEL=info
ENABLE_DEV_FAILURE_SIMULATION=false
ENABLE_DEMO_USER=false
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
